# Copy to .env.local and fill in.

# Unsplash API access key — used at build time to pull interior photography
# for the homepage and blog posts. Create an app at
# https://unsplash.com/oauth/applications and copy its "Access Key".
# Without this, the site falls back to a curated set of static photos.
UNSPLASH_ACCESS_KEY=""

# Resend — sends the newsletter welcome email from /api/subscribe.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender. "onboarding@resend.dev" works without domain setup but only
# delivers to your own Resend account address; verify yourdecornest.com in
# Resend and switch this to e.g. "DecorNest <hello@yourdecornest.com>" to
# deliver to real subscribers.
RESEND_FROM="DecorNest <onboarding@resend.dev>"
# Optional: address that gets a "new subscriber" notification on each signup.
NEWSLETTER_NOTIFICATION_TO=""
